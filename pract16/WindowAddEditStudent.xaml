<Window x:Class="pract16.WindowAddEditStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract16"
        xmlns:converters ="clr-namespace:pract16"
        mc:Ignorable="d"
        x:Name="AddEdit"
        Height="600" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Title="Добавление записи">
    <Window.Resources>
        <converters:BoolToIntConverter x:Key="BoolToIntConverter"/>
    </Window.Resources>
    <Grid Margin="40,0">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Фамилия:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
        <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1"/>
        <Label Content="Отчество:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2"/>
        <Label Content="№ зачет. книжки:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="3"/>
        <Label Content="Проживает в общежитии:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="4"/>
        <Label Content="Индекс группы:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="5"/>
        <Label Content="Математика:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="6"/>
        <Label Content="Программирование:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="7"/>
        <Label Content="История:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="8"/>
        <Label Content="Аналитика:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="9"/>
        <Label Content="Английский:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="10"/>
        <Button x:Name="btnAdd" Content="Добавить"  Grid.Row="11" HorizontalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Click="btnAdd_Click"/>
        <Button x:Name="btnCancel" Grid.Column="1" Content="Отмена" Grid.Row="11" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Click="btnCancel_Click"/>
        <TextBox x:Name="tbLastName" Text="{Binding Path=LastName}" Grid.Column="1"  TextWrapping="Wrap"  Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" MaxLength="50"/>
        <TextBox x:Name="tbFirstName" Text="{Binding Path=FirstName}" Grid.Column="1"  TextWrapping="Wrap"  Width="120" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" MaxLength="50"/>
        <TextBox x:Name="tbMiddleName" Text="{Binding Path=MiddleName}" Grid.Column="1"  TextWrapping="Wrap"  Width="120" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" MaxLength="50"/>
        <TextBox x:Name="tbNumber" Text="{Binding Path=NumberZachotka}" Grid.Column="1"  TextWrapping="Wrap"  Width="120" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" MaxLength="15"/>
        <TextBox x:Name="tbGroup" Text="{Binding Path=Groupe}" Grid.Column="1"  TextWrapping="Wrap"  Width="120" HorizontalAlignment="Center" Grid.Row="5" VerticalAlignment="Center" MaxLength="10"/>
        <ComboBox x:Name="cbLiveIn" Text="{Binding Path=LiveInObschaga}" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" Width="120">
            <ComboBoxItem Content="True"/>
            <ComboBoxItem Content="False"/>
        </ComboBox>
        <ComboBox x:Name="cbMath" Text="{Binding Path=Math}" Grid.Column="1" Grid.Row="6" VerticalAlignment="Center" Width="120" SelectedValue="{Binding Math, Converter={StaticResource BoolToIntConverter}}" SelectedValuePath="Content">
            
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="0"/>
        </ComboBox>
        <ComboBox x:Name="cbProg" Text="{Binding Path=Programming}" Grid.Column="1" Grid.Row="7" VerticalAlignment="Center" Width="120" SelectedValue="{Binding Programming, Converter={StaticResource BoolToIntConverter}}" SelectedValuePath="Content">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="0"/>
        </ComboBox>
        <ComboBox x:Name="cbHistory" Text="{Binding Path=History}" Grid.Column="1" Grid.Row="8" VerticalAlignment="Center" Width="120" SelectedValue="{Binding History, Converter={StaticResource BoolToIntConverter}}" SelectedValuePath="Content">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="0"/>
        </ComboBox>
        <ComboBox x:Name="cbAnalitic" Text="{Binding Path=Analitic}" Grid.Column="1" Grid.Row="9" VerticalAlignment="Center" Width="120" SelectedValue="{Binding Analitic, Converter={StaticResource BoolToIntConverter}}" SelectedValuePath="Content">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="0"/>
        </ComboBox>
        <ComboBox x:Name="cbEng" Text="{Binding Path=English}" Grid.Column="1" Grid.Row="10" VerticalAlignment="Center" Width="120" SelectedValue="{Binding English, Converter={StaticResource BoolToIntConverter}}" SelectedValuePath="Content">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="0"/>
        </ComboBox>
    </Grid>
</Window>
