<Window x:Class="pract16.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract16"
        mc:Ignorable="d"
        Title="Практическая №16" Height="800" Width="1000" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Menu VerticalAlignment="Top" Grid.ColumnSpan="2">
            <MenuItem Header="Таблица">
                <MenuItem Header=" fadadad"></MenuItem>
                <MenuItem Header="ddasdsad"></MenuItem>
                <MenuItem Header=""></MenuItem>
            </MenuItem>
            <MenuItem Header="О программе">
                <MenuItem Header="dasdsadsa"></MenuItem>
                <MenuItem></MenuItem>
            </MenuItem>
        </Menu>
        <DataGrid x:Name="dgStudent" IsReadOnly="True" AutoGenerateColumns="False" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Width="10*" Header="Код" Binding="{Binding Id}"/>
                <DataGridTextColumn Width="15*" Header="Фамилия" Binding="{Binding LastName}"/>
                <DataGridTextColumn Width="10*" Header="Имя" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Width="20*" Header="Отчество" Binding="{Binding MiddleName}"/>
                <DataGridTextColumn Width="15*" Header="№ зачетки" Binding="{Binding NumberZachotka}"/>
                <DataGridTextColumn Width="15*" Header="Общежитие" Binding="{Binding LiveInObschaga}"/>
                <DataGridTextColumn Width="10*" Header="Группа" Binding="{Binding Groupe}"/>
                <DataGridTextColumn Width="15*" Header="Математика" Binding="{Binding Math}"/>
                <DataGridTextColumn Width="25*" Header="Программирование" Binding="{Binding Programming}"/>
                <DataGridTextColumn Width="15*" Header="История" Binding="{Binding History}"/>
                <DataGridTextColumn Width="15*" Header="Аналитика" Binding="{Binding Analitic}"/>
                <DataGridTextColumn Width="15*" Header="Английский" Binding="{Binding English}"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Header="Редактирование:" Grid.Row="3" Margin="10">
            <StackPanel VerticalAlignment="Center" >
                <Button x:Name="btnAdd" Content="Создать запись" Margin="10"  Width="200" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Изменить запись" Margin="10"  Width="200" Click="btnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить запись" Margin="10"  Width="200" Click="btnDelete_Click"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="Поиск\Фильтр:" Grid.Row="3" Margin="10">
            <StackPanel VerticalAlignment="Center">
                <Label Content="По фамилии:"/>
                <TextBox x:Name="tbFind" TextWrapping="Wrap" Width="200"/>
                <Button x:Name="btnFind" Content="Поиск" Margin="10"  Width="200" Click="btnFind_Click"/>
                <TextBox x:Name="tbFiltr" TextWrapping="Wrap" Width="200"/>
                <Button x:Name="btnFiltr" Content="Фильтровать" Margin="10"  Width="200" Click="btnFiltr_Click"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
